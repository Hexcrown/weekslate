# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# Keep .env private: anyone with the link can read that calendar.
#
# iPhone: Calendar app > Calendars > (i) next to your Family calendar >
#         Public Calendar ON > Share Link > Copy.
# Several calendars: separate the links with commas.
CALENDAR_URLS=webcal://p123-caldav.icloud.com/published/2/EXAMPLE-LINK
